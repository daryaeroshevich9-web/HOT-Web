      "priority": 20,
      "when": { "event_index_eq": "SNOWFALL INTENSITIES", "intensity_eq": "Heavy" },
      "then": { "result": "CAUTION:  No holdover time  guidelines exist" }
    },
    {
      "id": "hot_iv_generic_snow_obscuration",
