    {
      "id": "hot_iv_generic_rain_temp_le_zero",
      "description": "Note 9 (TABLE 7): RA Cold-Soaked Wing at OAT ≤ 0 → CAUTION.",
      "priority": 60,
      "when": { "event_index_eq_table_len_ref": true, "temp_lte": 0 },
