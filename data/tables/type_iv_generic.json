      "priority": 30,
      "when": { "event_index_eq": "SNOWFALL INTENSITIES", "intensity_eq": "Moderate" },
      "then": { "event_index_override": 4 }
    },
    {
      "id": "hot_iv_generic_obscuration_warm",
      "description": "Non-freezing obscuration above 0°C → CAUTION.",
      "priority": 35,
