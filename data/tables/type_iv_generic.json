  "event_index": [
    ["FZFG", "FZBR", "IC", "ICFZFG", "ICFZBR"],
    ["never enter here from loop"],
    ["never enter here from loop"],
    ["-SN", "-SG", "-GS"],
    ["SN", "SG", "GS"],
    ["FZDZ"],
    ["-FZRA"],
    ["RA"]
  ],
  "event_index_rules": [
    {
      "id": "event_iv_generic_ice_pellets",
      "description": "Note 10 (TABLE 7): Ice pellets (PL) → Other column. PDF: 'ice pellets (PL)... No holdover time guidelines exist.' Applies to any event containing PL.",
      "priority": 1,
      "when": { "has_ice_pellets": true },
      "then": { "result": "PL_OTHER" }
    },
    {
      "id": "event_iv_generic_br_freezing",
      "description": "Note 2 (TABLE 7): BR at OAT ≤ 0 → FZBR (column 0). PDF: 'Freezing mist (FZBR) can occur when mist (BR) is present at 0°C and below.' Takes priority over rain+obscuration.",
      "priority": 2,
      "when": { "events_list_has_any": ["BR"], "temp_lte": 0 },
      "then": { "result": 0 }
    },
    {
      "id": "event_iv_generic_heavy_snow",
      "description": "Note 10 (TABLE 7): Heavy snow (+SN) → Other column (CAUTION). PDF: 'Heavy snow (+SN)... No holdover time guidelines exist.'",
      "priority": 3,
      "when": { "heavy_snowfall": true },
      "then": { "result": "HEAVY_SNOW" }
    },
    {
      "id": "event_iv_generic_rain_obscuration",
      "description": "Light rain with non-freezing obscuration (-RA + BR at OAT > 0) → no HOT guidelines.",
      "priority": 4,
      "when": { "events_list_eq": ["-RA", "BR"] },
      "then": { "result": "RAIN_OBSCURATION" }
    },
    {
      "id": "event_iv_generic_note6_heavy",
      "description": "Note 8 (TABLE 7): SNRA/RASN/SNDZ/DZSN with heavy intensity → CAUTION.",
      "priority": 5,
      "when": { "note_6": true, "intensity_in": ["Heavy"] },
      "then": { "result": "NOTE6_CAUTION" }
    },
    {
      "id": "event_iv_generic_note6_moderate",
      "description": "Note 8 (TABLE 7): SNRA/RASN/SNDZ/DZSN with moderate intensity → use SNRA column.",
      "priority": 5,
      "when": { "note_6": true, "intensity_in": ["Moderate"] },
      "then": { "result": "NOTE6_SNRA" }
    },
    {
      "id": "event_iv_generic_note6_light",
      "description": "Note 8 (TABLE 7): SNRA/RASN/SNDZ/DZSN with VL/Light intensity → use -FZRA column.",
      "priority": 6,
      "when": { "note_6": true, "intensity_in": ["Very Light", "Light"] },
      "then": { "result": "NOTE6_FZRA" }
    },
    {
      "id": "event_iv_generic_snow_fzfg",
      "description": "Note 4 (TABLE 7): -SNFZFG/SNFZFG → column 1.",
      "priority": 7,
      "when": { "snow_fzfg": true },
      "then": { "result": 1 }
    },
    {
      "id": "event_iv_generic_snow_obscuration",
      "description": "Snow with non-freezing obscuration → intensity may be overestimated.",
      "priority": 10,
      "when": { "snowfall_and_obscuration": true },
      "then": { "result": "SNOWFALL_OBSCURATION" }
    },
    {
      "id": "event_iv_generic_snow",
      "description": "Note 5 (TABLE 7): Snowfall (SN/SG/GS) → determine intensity via TABLE 1.",
      "priority": 20,
      "when": { "snowfall": true },
      "then": { "result": "SNOWFALL INTENSITIES" }
    },
    {
      "id": "event_iv_generic_obscuration_cold_extreme",
      "description": "Non-freezing obscurations below -25°C → CAUTION.",
      "priority": 27,
      "when": { "events_list_has_any": ["FG", "BR"], "temp_lt": -25 },
      "then": { "result": "OBSCURATION_COLD_EXTREME" }
    },
    {
      "id": "event_iv_generic_obscuration_warm",
      "description": "Non-freezing obscurations above 0°C → no HOT column exists.",
      "priority": 28,
      "when": { "events_list_has_any": ["FG", "BR"], "temp_gt": 0 },
      "then": { "result": "OBSCURATION_WARM" }
    },
    {
      "id": "event_iv_generic_obscuration",
      "description": "Non-freezing obscurations at OAT ≤ 0 without snow → use FZFG/FZBR column (index 0).",
      "priority": 30,
      "when": { "events_list_has_any": ["FG", "BR"] },
      "then": { "result": 0 }
    }
  ],
  "rules": [
    {
      "id": "hot_iv_generic_pl_other",
      "description": "Note 10 (TABLE 7): Ice pellets (PL) → no HOT guidelines. Use Allowance Times tables instead.",
      "priority": 9,
      "when": { "event_index_eq": "PL_OTHER" },
      "then": { "result": "CAUTION:  No holdover time  guidelines exist" }
    },
    {
      "id": "hot_iv_generic_heavy",
      "description": "Heavy snowfall intensity → no HOT.",
      "priority": 10,
      "when": { "event_index_eq": "Heavy" },
      "then": { "result": "CAUTION:  No holdover time  guidelines exist" }
    },
    {
      "id": "hot_iv_generic_snow_fzfg_heavy",
