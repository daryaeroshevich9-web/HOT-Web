      "priority": 11,
      "when": { "event_index_eq": 1, "intensity_eq": "Heavy" },
      "then": { "result": "CAUTION:  No holdover time  guidelines exist" }
    },
    {
      "id": "hot_iv_generic_note9_snra_cold",
      "description": "Note 9 (TABLE 7): No HOT for SNRA/RASN at OAT ≤ 0°C. PDF: 'No holdover time guidelines exist for this condition for 0°C and below.'",
      "priority": 11,
      "when": { "event_index_eq": "NOTE6_SNRA", "temp_lte": 0 },
      "then": { "result": "CAUTION:  No holdover time  guidelines exist" }
    },
    {
      "id": "hot_iv_generic_note9_fzra_cold",
      "description": "Note 9 (TABLE 7): No HOT for light SNRA/RASN redirected to FZRA at OAT ≤ 0°C.",
      "priority": 12,
      "when": { "event_index_eq": "NOTE6_FZRA", "temp_lte": 0 },
      "then": { "result": "CAUTION:  No holdover time  guidelines exist" }
    },
    {
      "id": "hot_iv_generic_note6_caution",
      "description": "Note 8 (TABLE 7): SNRA/RASN heavy → CAUTION.",
      "priority": 13,
      "when": { "event_index_eq": "NOTE6_CAUTION" },
      "then": { "result": "CAUTION:  No holdover time  guidelines exist" }
    },
    {
      "id": "hot_iv_generic_note6_snra",
      "description": "Note 8 (TABLE 7): SNRA/RASN moderate at OAT > 0 → SNRA column (index 8).",
      "priority": 14,
      "when": { "event_index_eq": "NOTE6_SNRA" },
      "then": { "event_index_override": 8 }
    },
    {
      "id": "hot_iv_generic_note6_fzra",
      "description": "Note 8 (TABLE 7): SNRA/RASN light/VL at OAT > 0 → -FZRA column (index 6).",
      "priority": 15,
      "when": { "event_index_eq": "NOTE6_FZRA" },
      "then": { "event_index_override": 6 }
    },
    {
      "id": "hot_iv_generic_heavy_snow",
      "description": "Note 10 (TABLE 7): Heavy snowfall (+SN) → no HOT.",
      "priority": 14,
      "when": { "event_index_eq": "HEAVY_SNOW" },
      "then": { "result": "CAUTION:  No holdover time  guidelines exist" }
    },
    {
      "id": "hot_iv_generic_snow_heavy",
